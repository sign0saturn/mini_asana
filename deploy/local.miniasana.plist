<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>local.miniasana</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/python3</string>
		<string>/Users/YOUR_USERNAME/mini-asana/server.py</string>
	</array>
	<key>WorkingDirectory</key>
	<string>/Users/YOUR_USERNAME/mini-asana</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/Users/YOUR_USERNAME/mini-asana/server.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/YOUR_USERNAME/mini-asana/server.log</string>
</dict>
</plist>
