<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>local.miniasana-backup-offsite</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>/Users/YOUR_USERNAME/mini-asana/backup_offsite.sh</string>
	</array>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key><integer>4</integer>
		<key>Minute</key><integer>23</integer>
	</dict>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardOutPath</key>
	<string>/Users/YOUR_USERNAME/mini-asana/backup_offsite.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/YOUR_USERNAME/mini-asana/backup_offsite.log</string>
</dict>
</plist>
